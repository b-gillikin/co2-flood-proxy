{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "timer",
      "type": "timerTrigger",
      "direction": "in",
      "schedule": "%KNMI_BACKFILL_SCHEDULE%"
    },
    {
      "name": "diagnostic",
      "type": "blob",
      "direction": "out",
      "path": "knmi-data/state/knmi_invocation_diagnostic.json",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
